PORT=3000
FRONTEND_URL=http://localhost:5173
DATABASE_PATH=./db/aptus.db
JWT_SECRET=troque-esta-chave-por-uma-com-no-minimo-32-caracteres
JWT_EXPIRACAO=24h
BCRYPT_ROUNDS=10
NODE_ENV=development

# Chaves de API Externas
ANTHROPIC_API_KEY=sua-chave-api-do-claude-aqui
UNSPLASH_API_KEY=sua-chave-api-do-unsplash-aqui
OPENAI_API_KEY=sua-chave-api-do-openai-aqui-opcional

# Configurações de Upload
MAX_UPLOAD_SIZE=10mb
UPLOAD_DIR=./uploads

# Configurações de Email (opcional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu-email@gmail.com
SMTP_PASSWORD=sua-senha-app-google
SMTP_FROM=noreply@aptus.com.br

